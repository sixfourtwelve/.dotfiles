#   dot completions > ~/.config/fish/completions/dot.fish

complete -c dot -f

set -l cmds init update doctor stow unstow package check-packages retry-failed \
    gen-ssh-key gen-gpg-key ollama repos tools fonts secret-scan completions link unlink edit help

complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a init            -d "Full machine setup"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a update          -d "Pull, upgrade, restow, sync"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a doctor          -d "Health check"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a stow            -d "Re-symlink home/ into ~"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a unstow          -d "Remove home/ symlinks"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a package         -d "Manage bundles"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a check-packages  -d "Installed vs missing"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a retry-failed    -d "Re-run failed init steps"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a gen-ssh-key     -d "Generate an SSH key"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a gen-gpg-key     -d "Generate a GPG signing key"
complete -c dot -n "not __fish_seen_subcommand_from $cmds" -a ollama          -d "Manage ollama models"
