cmd_help() {
  cat <<EOF
${C_BOLD}dot${C_RESET} — dotfiles CLI for $DOTFILES_DIR

${C_BOLD}SETUP${C_RESET}
  init [flags]              Full setup: brew, bundles, stow, keys, models, plugins
  update [--work]           git pull, brew upgrade, restow, sync models
  doctor                    Health check; exits non-zero on failure
  retry-failed              Re-run whatever failed during the last init

${C_BOLD}SYMLINKS${C_RESET}
  stow                      Re-symlink home/ into \$HOME
  unstow                    Remove those symlinks
  link / unlink             Put 'dot' on PATH via ~/.local/bin

${C_BOLD}PACKAGES${C_RESET}
  package add <name> [brew|cask] [base|work]
                            Add to a bundle and install. Kind is auto-detected.
  package remove <name> [base|work]
  package update            brew update && brew upgrade
  package list              Show both bundles
  check-packages            Installed vs missing, per bundle

${C_BOLD}KEYS${C_RESET}
  gen-ssh-key [--force]     ed25519 SSH key, agent, gh ssh-key add
  gen-gpg-key               ed25519 GPG key, git signing config, gh gpg-key add

${C_BOLD}MODELS${C_RESET}
  ollama list               Manifest vs installed
  ollama pull <model>       Pull and record in the manifest
  ollama sync               Pull everything the manifest declares and you lack

${C_BOLD}REPOS${C_RESET}
  repos list                Manifest vs what is cloned
  repos clone               Clone everything missing (needs SSH set up first)
  repos add <owner/repo> [dest]
                            Add to the manifest and clone
  fonts                     Install fonts from the mono-lisa clone
  skills                    Sync skills from the sixfourtwelve/skills clone

${C_BOLD}TOOLS${C_RESET}
  tools list                packages/tools vs what is on PATH
  tools install [name...] [--force]
                            Run the upstream 'curl | sh' installer for anything
                            missing. Already-installed tools are skipped.

${C_BOLD}OTHER${C_RESET}
  secret-scan               Scan tracked files for credential-shaped strings
  completions               Emit fish completions
  edit                      Open the repo in \$EDITOR
  help                      This

${C_BOLD}INIT FLAGS${C_RESET}
  --skip-ssh  --skip-gpg  --skip-ollama  --skip-casks  --skip-repos
  --skip-tools  --work  --dry-run
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift

  # --dry-run is accepted anywhere, not just on init.
  local -a args=()
  local a
  for a in "$@"; do
    if [ "$a" = "--dry-run" ] && [ "$cmd" != "init" ]; then
      DRY_RUN=true
    else
      args+=("$a")
    fi
  done
  set -- ${args[@]+"${args[@]}"}

  case $cmd in
    init)             cmd_init "$@" ;;
    update)           cmd_update "$@" ;;
    doctor)           cmd_doctor ;;
    stow)             cmd_stow ;;
    unstow)           cmd_unstow ;;
    package)          cmd_package "$@" ;;
    check-packages)   cmd_check_packages ;;
    retry-failed)     cmd_retry_failed ;;
    gen-ssh-key)      cmd_gen_ssh_key "$@" ;;
    gen-gpg-key)      cmd_gen_gpg_key ;;
    ollama)           cmd_ollama "$@" ;;
    repos)            cmd_repos "$@" ;;
    tools)            cmd_tools "$@" ;;
    fonts)            cmd_fonts ;;
    skills)           cmd_skills ;;
    secret-scan)      cmd_secret_scan ;;
    completions)      cmd_completions ;;
    link)             cmd_link ;;
    unlink)           cmd_unlink ;;
    edit)             cmd_edit ;;
    help|-h|--help)   cmd_help ;;
    *) err "unknown command '$cmd'"; printf '\n'; cmd_help; exit 1 ;;
  esac
}

main "$@"
