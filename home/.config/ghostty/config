theme = Catppuccin Mocha

font-family-italic = MonoLisa Nerd Font
font-family-bold-italic = MonoLisa Nerd Font
font-family-bold = MonoLisa Nerd Font
font-family = MonoLisa Nerd Font

# Font size

font-size = 24
font-thicken = true
bold-is-bright = true

# Opacity of split windows

unfocused-split-opacity = 0.97

# Set the background-opacity to be fully opaque

background-opacity = 1.0

# Cursor style

cursor-style-blink = true

# Clipboard settings

clipboard-read = allow
clipboard-write = allow

# macos options

#macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

# Always show ghostty as the title
title = terfynell

# Window settings

window-width = 90
window-height = 30
window-colorspace = display-p3
window-padding-color = background
window-padding-balance = true
window-padding-x = 4
window-padding-y = 4