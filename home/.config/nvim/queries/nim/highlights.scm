; extends

; Consolidate all keywords to use consistent @keyword styling

[
  "const"
  "let"
  "var"
  "concept"
  "asm"
  "bind"
  "defer"
  "do"
  "mixin"
  "static"
  "tuple"
  "block"
  "using"
  "discard"
  "enum"
  "object"
  "type"
  "proc"
  "func"
  "method"
  "converter"
  "iterator"
  "and"
  "or"
  "xor"
  "not"
  "div"
  "mod"
  "shl"
  "shr"
  "from"
  "as"
  "of"
  "in"
  "notin"
  "is"
  "isnot"
  "cast"
  "return"
  "yield"
  "if"
  "when"
  "case"
  "elif"
  "else"
  "for"
  "while"
  "continue"
  "break"
  "import"
  "include"
  "export"
  "try"
  "except"
  "finally"
  "raise"
  "out"
  "distinct"
  "ref"
  "ptr"
] @keyword

; "static" and "addr" are parsed as ordinary calls rather than keyword tokens
((call
  function: (identifier) @keyword)
  (#any-of? @keyword "static" "addr"))
