; Consolidate all keywords to use consistent @keyword styling

[
  "if"
  "else"
  "switch"
  "case"
  "import"
  "from"
  "as"
  "export"
  "for"
  "of"
  "do"
  "while"
  "continue"
  "break"
  "const"
  "debugger"
  "extends"
  "get"
  "let"
  "set"
  "static"
  "target"
  "var"
  "with"
  "class"
  "async"
  "await"
  "return"
  "yield"
  "function"
  "new"
  "delete"
  "in"
  "instanceof"
  "typeof"
  "throw"
  "try"
  "catch"
  "finally"
  "default"
] @keyword

(unary_expression
  [
    "delete"
    "void"
  ] @keyword)
