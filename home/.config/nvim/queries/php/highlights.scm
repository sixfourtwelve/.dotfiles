; Consolidate all keywords to use consistent @keyword styling

[
  "and"
  "as"
  "instanceof"
  "or"
  "xor"
  "fn"
  "function"
  "clone"
  "declare"
  "default"
  "echo"
  "enddeclare"
  "extends"
  "global"
  "goto"
  "implements"
  "insteadof"
  "print"
  "new"
  "unset"
  "enum"
  "class"
  "interface"
  "namespace"
  "trait"
  "abstract"
  "const"
  "final"
  "private"
  "protected"
  "public"
  "readonly"
  "static"
  "return"
  "exit"
  "yield"
  "case"
  "else"
  "elseif"
  "endif"
  "endswitch"
  "if"
  "switch"
  "match"
  "break"
  "continue"
  "do"
  "endfor"
  "endforeach"
  "endwhile"
  "for"
  "foreach"
  "while"
  "catch"
  "finally"
  "throw"
  "try"
  "include_once"
  "include"
  "require_once"
  "require"
  "use"
] @keyword

(static_modifier) @keyword

(function_static_declaration
  "static" @keyword)

(yield_expression
  "from" @keyword)
