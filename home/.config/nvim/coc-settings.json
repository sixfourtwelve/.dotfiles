{
    "languageserver": {
        "terraform": {
            "command": "terraform-ls",
            "args": [
                "serve"
            ],
            "filetypes": [
                "terraform",
                "tf"
            ],
            "initializationOptions": {},
            "settings": {}
        },
        "golang": {
            "command": "gopls",
            "rootPatterns": [
                "go.mod",
                ".vim/",
                ".git/",
                ".hg/"
            ],
            "filetypes": [
                "go"
            ]
        },
        "odin": {
            "command": "ols",
            "rootPatterns": [
                "ols.json",
                ".vim/",
                ".git/",
                ".hg/"
            ],
            "filetypes": [
                "odin"
            ]
        },
        "ocaml": {
            "command": "ocamllsp",
            "rootPatterns": [
                ".ml",
                ".mli"
            ],
            "filetypes": [
                "ocaml"
            ]
        },
        "clangd": {
            "command": "clangd",
            "rootPatterns": [
                "compile_commands.json",
                "compile_flags.txt",
                ".git/"
            ],
            "filetypes": [
                "c",
                "cpp",
                "objc",
                "objcpp"
            ],
            "initializationOptions": {
                "clangdFileStatus": true
            }
        }
    },
    "semanticTokens.enable": false,
    "suggest.noselect": false,
    "suggest.removeDuplicateItems": true,
    "suggest.completionItemKindLabels": {
        "keyword": "\uf1de",
        "variable": "\ue79b",
        "value": "\uf89f",
        "operator": "\u03a8",
        "constructor": "\uf0ad",
        "function": "\u0192",
        "reference": "\ufa46",
        "constant": "\uf8fe",
        "method": "\uf09a",
        "struct": "\ufb44",
        "class": "\uf0e8",
        "interface": "\uf417",
        "text": "\ue612",
        "enum": "\uf435",
        "enumMember": "\uf02b",
        "module": "\uf40d",
        "color": "\ue22b",
        "property": "\ue624",
        "field": "\uf9be",
        "unit": "\uf475",
        "event": "\ufacd",
        "file": "\uf723",
        "folder": "\uf114",
        "snippet": "\ue60b",
        "typeParameter": "\uf728",
        "default": "\uf29c"
    },
    "inlayHint.enable": false,
    "[c]": {
        "codeLens.enable": false,
        "clangd.inlayHints.enable": false
    },
    "[cpp]": {
        "codeLens.enable": false,
        "clangd.inlayHints.enable": false
    },
    "codeLens.enable": false,
    "codeLens.separator": "🔍",
    "coc.preferences.jumpCommand": "drop",
    "coc.preferences.formatOnSave": true,
    "diagnostic.checkCurrentLine": false,
    "diagnostic.messageTarget": "float",
    "diagnostic.virtualText": true,
    "diagnostic.virtualTextCurrentLineOnly": false,
    "prettier.disableLanguages": [
        "yaml
    ],
    "snippets.ultisnips.pythonPrompt": false
}
